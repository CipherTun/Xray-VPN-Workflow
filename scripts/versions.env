# Single source of truth for the tunnel library the app is built against.
# Read by scripts/setup.sh and the GitHub workflow. Plain KEY=VALUE lines only (no spaces, no quotes), so it works
# with bash `source` and `>> $GITHUB_ENV`.

# V2-TUN, the Go tunnel library (built into android-libs/v2tun.aar by scripts/build_core.sh).
V2TUN_REPO=CipherTun/V2-TUN
V2TUN_REF=fix/review-20261104
