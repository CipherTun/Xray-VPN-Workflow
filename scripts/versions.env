# Single source of truth for every pinned upstream version.
# Read by scripts/ci_fetch_core.sh, scripts/build_cores.sh and the GitHub workflow.
# Plain KEY=VALUE lines only (no spaces, no quotes), so it works with bash `source` and `>> $GITHUB_ENV`.

# Android core: AndroidLibXrayLite (gomobile library behind v2rayNG), built against the Xray-core commit below.
CORE_REPO=2dust/AndroidLibXrayLite
CORE_REF=2ffe5f794a32ba15b122e177b5acffc6f11c4959
XRAY_CORE_REPO=XTLS/Xray-core
XRAY_CORE_TAG=v26.10.31
XRAY_CORE_COMMIT=a4a3dff5b20c2faae567b742c172c7b95e75c083

# iOS core: libXray (the only Xray wrapper with an iOS target). Its tags follow the Xray-core version.
LIBXRAY_TAG=v26.10.31
